{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F030F4P6 OpenOCD",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",

      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/Clock_F030F4P6.elf",

      "device": "STM32F030F4P6",
      "interface": "swd",

      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f0x.cfg"
      ],

      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",

      "openOCDLaunchCommands": [
        "adapter speed 1000"
      ],

      "preLaunchCommands": [
        "monitor reset halt"
      ],

      "postLaunchCommands": [
        "monitor reset halt"
      ]
    }
  ]
}